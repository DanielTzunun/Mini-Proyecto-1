variable:entero x = "hola";          // tipo incompatible
guardar 5 en y;                      // y no existe
guardar 9 en iva;                    // constante
guardar 'a' en edad;                 // tipo incompatible
variable:entero z;
guardar z en edad;                   // z no tiene valor
